# CareFlow Platform Configuration Example

# Core Backend
PROJECT_NAME="CareFlow"
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-secure-random-secret-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Default: Async SQLite for local instant run, or PostgreSQL for production)
DATABASE_URL="sqlite+aiosqlite:///./careflow.db"
# DATABASE_URL="postgresql+asyncpg://careflow_user:careflow_pass@localhost:5432/careflow"

# Redis & Pub/Sub (Optional: falls back to in-memory pubsub if not provided)
REDIS_URL="redis://localhost:6379/0"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# AI Integration (Optional: Gemini 2.5 Flash for Pre-Visit Briefing)
GEMINI_API_KEY=""

# Public Verification URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:8000"
